# Copy this file to .env and fill it in. .env is git-ignored; this file is not,
# so never put a real password here.

# Database user from Atlas > Database Access
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Atlas > Database > Connect > Drivers > Node.js.
# May keep its <db_username>/<db_password> placeholders — the two values above
# are spliced in (and URL-encoded) by data/database.js.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Local MongoDB instead? Use this form and leave username/password blank:
# MONGODB_URI=mongodb://127.0.0.1:27017

# A NEW database, separate from the week 01-02 contacts project.
MONGODB_DB_NAME=boardgames

PORT=8080

# ---------------------------------------------------------------------------
# Week 04 (OAuth). Leave blank until then.
# ---------------------------------------------------------------------------

# Any long random string. Signs the session cookie so it cannot be forged.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App.
# A GitHub OAuth app allows exactly ONE callback URL, so make two apps: one for
# localhost (below) and one for Render, each with its own id and secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback
